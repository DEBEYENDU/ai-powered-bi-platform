# Copy to .env and adjust if needed. Safe to commit (no secrets).

# Backend URL the Vite dev proxy targets (server-side only, not exposed to the browser).
# If port 8000 is unavailable on your system, set BACKEND_URL here (e.g. http://127.0.0.1:8080)
BACKEND_URL=http://127.0.0.1:8000

# Frontend dev server port (fixed in vite.config.ts)

# Copy to .env and adjust if needed. Safe to commit (no secrets).

# Backend URL the Vite dev proxy targets (server-side only, not exposed to the browser).
# Windows note: port 8000 may be reserved on some systems; 8080 is the local default.
BACKEND_URL=http://127.0.0.1:8080

